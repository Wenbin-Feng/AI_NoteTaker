# Existing OpenRouter key; keep this server-side.
LLM_API_KEY=''

# OpenRouter endpoint.
LLM_BASE_URL='https://openrouter.ai/api/v1'

# Existing selected model; change only if it becomes unavailable.
LLM_MODEL='nvidia/nemotron-3-ultra-550b-a55b:free'

# REQUIRED for Supabase/Vercel. Supabase > Connect > Transaction pooler.
# Paste the full URI with the actual database password (percent-encoded).
# Empty = local SQLite only. No Supabase API/anon/service-role key is needed.
DATABASE_URL=''

# Local development port.
PORT='5001'

# Optional when Vercel CLI is already logged in: https://vercel.com/account/tokens
VERCEL_TOKEN=''

# REQUIRED: Vercel account/team ID from Settings or .vercel/project.json.
VERCEL_ORG_ID=''

# REQUIRED: Vercel Project Settings > General > Project ID.
VERCEL_PROJECT_ID=''

# Fill after deployment: public production URL for smoke tests.
APP_URL=''
